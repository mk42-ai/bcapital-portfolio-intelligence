{
  "name": "bcapital-portfolio-intelligence",
  "version": "1.0.0",
  "description": "B Capital Portfolio Intelligence — backend API (Hono + Drizzle ORM + SQLite via sql.js) fed by OnDemand Flow Builder workflows.",
  "type": "module",
  "main": "dist/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "seed:json": "python3 scripts/generate_seed.py data/brand-matrix.xlsx data/seed.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/portfolio.sqlite && npm run db:migrate && npm run db:seed",
    "openapi": "tsx scripts/write-openapi.ts",
    "build": "tsc -p tsconfig.json && npm run openapi",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "smoke": "tsx scripts/smoke.ts",
    "test": "tsx scripts/test.ts",
    "test:pitchbook": "tsx scripts/test-pitchbook.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.9",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}

# Names only — never commit values. The OnDemand apikey is NEVER needed by this API (it is read-only data + a shared-secret ingest).
PORT=3000
BASE_PATH=                       # e.g. /apps/bcap-portfolio-api when served behind serverless.on-demand.io
PUBLIC_BASE_URL=                 # absolute URL advertised in /openapi.json servers[]
INGEST_SECRET=                   # 32-byte hex generated at build (openssl rand -hex 32); shared with the Flow Builder HTTP step
ONDEMAND_DEFAULT_MODEL=predefined-deepseek-flash   # DeepSeek Flash v4.1 (endpoint_name deepseek-v4.1-flash)
ONDEMAND_REASONING_MODE=medium
EARLIEST_TEST_UTC=
DB_PATH=./data/portfolio.sqlite

# OnDemand (server-only; needed by POST /refresh and the hourly scheduler)
ONDEMAND_API_KEY=
ONDEMAND_BASE_URL=https://api.on-demand.io
ONDEMAND_NEWS_PLUGIN_ID=plugin-1722260873    # Perplexity — the only plugin used
ONDEMAND_NEWS_PLUGIN_IDS=plugin-1722260873   # comma list override; keep Perplexity-only, no other ids are wired
REFRESH_CRON_MINUTES=60   # 0 disables the in-process scheduler

# Vercel (vercel.json services: app = this API at /backend, web = Next.js at /)
# The web service gets PORTFOLIO_API_URL from a service binding — do NOT set it in the Vercel project.
CRON_SECRET=              # Vercel Cron sends it as "Authorization: Bearer …" to GET /backend/cron/refresh
REFRESH_CRON_LIMIT=6      # companies per cron tick (concurrency 6 ≈ one ~2-minute round, inside the 300 s function limit)
BLOB_READ_WRITE_TOKEN=    # injected when a Vercel Blob store is connected; enables DB persistence across cold starts
BLOB_DB_PATHNAME=db/portfolio.sqlite

# Video artifacts: the backend accepts kind "video" on POST /artifacts regardless of flags (X-Ingest-Secret required). The FRONTEND gate is
# web/.env MEDIA_ALLOW_VIDEO=1 (default 0 → /api/media rejects .mp4/.webm with unsupported_type "video uploads are disabled"); when on, the Next
# server relays the bytes here with mediaStatus "local" and no OnDemand media id. Playwright sets MEDIA_ALLOW_VIDEO=1 + INGEST_SECRET=test-secret
# against a local server started with the same INGEST_SECRET (see web/.env.test.example). Direct POSTs to the LIVE /artifacts still need the real secret.

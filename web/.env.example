# Public (browser) configuration — no secrets here.
NEXT_PUBLIC_PORTFOLIO_API_URL=https://<backend-sandbox>.vercel.run
# Model and plugin are fixed in code (predefined-deepseek-flash = DeepSeek Flash v4.1, reasoningMode medium, plugin-1722260873 Perplexity only) — no env override.
NEXT_PUBLIC_DEFAULT_EXTERNAL_USER_ID=INV-001
# OnDemand plugin id of the registered "Portfolio Plugin" (REST tool over the backend API). When set, web/src/lib/plugins.ts lists it BEFORE Perplexity
# and it is added to the plugin allow-list. Registered 2026-10-11T10:13:56Z via ai_generated_tool_create as plugin-1791713636 (agent-1791713636, name
# "B Capital Portfolio Intelligence", 3 GET ops over https://sb-23wo7xiys7fz.vercel.run, auth none) — see proof/data-lane/plugin-registration-2026-10-11b.log.txt.
# NOTE: its schema pins servers[0] to that sandbox URL; re-register (scripts/register-plugin.ts) when the backend moves.
NEXT_PUBLIC_PORTFOLIO_PLUGIN_ID=plugin-1791713636
NEXT_PUBLIC_EARLIEST_TEST_UTC=2026-10-09T12:37:25Z
NEXT_PUBLIC_SITE_URL=https://<frontend-sandbox>.vercel.run
# Chat query runs IN THE BROWSER (lib/ondemand/browser-chat.ts → api.on-demand.io directly). This key is shipped in the client bundle and is
# readable by anyone who loads the site. Leave empty to proxy every turn through POST /api/chat with the server-side ONDEMAND_API_KEY instead.
NEXT_PUBLIC_ONDEMAND_API_KEY=G7Ggtw0eqfAekxmdo2vFvXTtcC63VjnL
# direct (default) | proxy — `proxy` forces POST /api/chat even when a browser key exists (mock-SSE specs, replay scripts).
NEXT_PUBLIC_CHAT_TRANSPORT=direct
# ---- Server-side only (never NEXT_PUBLIC_, never logged, never in the client bundle) ----
ONDEMAND_BASE_URL=https://api.on-demand.io
ONDEMAND_API_KEY=<your OnDemand apikey — sent as the `apikey` header by /api/chat and /api/ondemand/*>
PORTFOLIO_API_URL=https://<backend-sandbox>.vercel.run
# Shared secret for POST {backend}/pitchbook/run ("Run now" on the PitchBook panel) — relayed by /api/pitchbook/run as X-Ingest-Secret; never sent to the browser.
INGEST_SECRET=
# ---- Media / video feature flag ----
# Video uploads (.mp4/.webm) via /api/media. Default 0 = rejected with the unsupported_type message ("video uploads are disabled").
# When 1, video is stored as a backend artifact ONLY (mediaStatus "local", "video stored in the backend only (no OnDemand video plugin)") —
# the OnDemand Media API registration is skipped because the account has no video file plugin (web/src/lib/artifacts/media.ts).
MEDIA_ALLOW_VIDEO=0
# Playwright evidence env (web/.env.test.example) sets MEDIA_ALLOW_VIDEO=1 together with INGEST_SECRET=test-secret against a LOCAL backend
# started with the same INGEST_SECRET. What still needs the REAL secret: a DIRECT `POST {backend}/artifacts` (X-Ingest-Secret) against the live
# backend — e.g. an external script or a test that bypasses the Next server. The relay path (browser → /api/media → saveArtifact → backend
# /artifacts) works WITHOUT the user holding the secret because the Next server sends it from its own INGEST_SECRET env.

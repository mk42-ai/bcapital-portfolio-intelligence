# Playwright / evidence-suite environment (DOCUMENTATION ONLY — copy to web/.env.test; never commit real values).
# Start the backend locally with the SAME secret:  PORT=4795 DB_PATH=/tmp/portfolio-test.sqlite INGEST_SECRET=test-secret npx tsx src/server.ts
PORTFOLIO_API_URL=http://localhost:4795
NEXT_PUBLIC_PORTFOLIO_API_URL=http://localhost:4795
# Enables .mp4/.webm uploads in /api/media (stored as backend artifacts only, mediaStatus "local"; no OnDemand video plugin exists on the account).
MEDIA_ALLOW_VIDEO=1
# Relay secret used by the Next server for POST {backend}/artifacts and /pitchbook/run. "test-secret" only works against a LOCAL backend started
# with INGEST_SECRET=test-secret. A test that POSTs DIRECTLY to the LIVE backend's /artifacts needs the REAL INGEST_SECRET (not stored anywhere in the repo);
# the browser→/api/media→backend relay never exposes it to the user.
INGEST_SECRET=test-secret
# Optional: leave empty to run uploads without OnDemand (documents fall back to local extraction / "stored in Artifacts only").
ONDEMAND_API_KEY=
